# Python
.venv/
venv/
env/

# Environment variables (never commit real secrets)
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Runtime SQLite databases (generated at startup)
backend/*.db
*.db

# Raw training data — large, not needed to serve the app
data/external/
data/raw/

# Generated EDA / training plots — not needed at runtime
reports/
ml/models/artifacts/plots/

# Python-Vercel files (backend runs on Railway, not Vercel)
api/
uv.lock
.python-version

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDEs
.DS_Store
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*~
