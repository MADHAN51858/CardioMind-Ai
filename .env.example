# CardioMind Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to git.

# Google Gemini API Key (required for CardioAI chat & doctor lookup)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection for Chat Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?appName=Cluster0

# Security
SECRET_KEY=your_secret_key_here
